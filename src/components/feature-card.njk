<li class="feature-list__item">
	<div class="feature-list__item-heading">
		<svg
			class="feature-list__item-icon svg-icon"
			viewBox="0 0 24 24"
			aria-hidden="true"
			focusable="false"
		>
			<use href="#{{ item.icon }}" xlink:href="#{{ item.icon }}"></use>
		</svg>
		<h3 class="feature-list__item-title">{{ item.title }}</h3>
	</div>
	<p class="feature-list__item-description">{{ item.description }}</p>
</li>
